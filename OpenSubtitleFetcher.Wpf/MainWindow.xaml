<Window x:Class="OpenSubtitleFetcher.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:system="clr-namespace:System;assembly=System.Runtime"
        xmlns:enums="clr-namespace:OpenSubtitleFetcher.Domain.Models.Enums;assembly=OpenSubtitleFetcher.Domain"
        xmlns:viewModels="clr-namespace:OpenSubtitleFetcher.Wpf.ViewModels"
        mc:Ignorable="d"
        Title="OpenSubtitle fetcher" Height="450" Width="800" d:DataContext="{d:DesignInstance viewModels:MainWindowViewModel}">
    <Window.Resources>
        <ObjectDataProvider x:Key="LanguageEnum" MethodName="GetValues"
                            ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="enums:Language"/>
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>
    </Window.Resources>
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" MaxHeight="100"/>
            <RowDefinition Height="14*"/>
            <RowDefinition Height="*" MaxHeight="50"/>
            <RowDefinition Height="4*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="7*"/>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <TextBox Text="{Binding Urls}" Grid.Row="0" Grid.Column="0"/>
        <Button Grid.Row="0" Grid.Column="1" Command="{Binding SelectDirectoriesCommand}" Margin="10, 0">Browse...</Button>
        <Button Grid.Row="0" Grid.Column="2" Command="{Binding GetFilesCommand}">Open</Button>
        <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="3" Margin="0,10" BorderBrush="Black" BorderThickness="1">
            <ListView ItemsSource="{Binding FileList}" Margin="5" HorizontalAlignment="Stretch">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Fetch">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type viewModels:VideoFileViewModel}">
                                    <CheckBox Margin="5,0" IsChecked="{Binding IsChecked}"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="File name">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate DataType="{x:Type viewModels:VideoFileViewModel}">
                                    <TextBlock Margin="5,0" Text="{Binding FileName}" HorizontalAlignment="Stretch"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Border>
        <WrapPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="3">
            <ComboBox ItemsSource="{Binding Source={StaticResource LanguageEnum}}"
                      SelectedItem="{Binding Language}" />
            <Button Margin="10,0" Command="{Binding SubmitCommand}">Download</Button>
        </WrapPanel>
        <Border Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="3" Margin="0, 10" BorderThickness="1" BorderBrush="Black">
            <ScrollViewer>
                <TextBlock VerticalAlignment="Stretch" HorizontalAlignment="Stretch" Text="{Binding LogBlock}" />
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
